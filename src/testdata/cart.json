{
  "page": {
    "url": "/playwright/ttacart/cart",
    "title": "TTACart - Your Cart",
    "heading": "Your Cart",
    "emptyMessage": "Your cart is empty."
  },
  "scenarios": {
    "emptyCart": {
      "addProducts": [],
      "expectedBadge": null
    },
    "singleItem": {
      "addProducts": [
        { "slug": "tta-bike-light", "name": "TTA Bike Light", "price": "$9.99" }
      ],
      "expectedBadge": "1"
    },
    "multipleItems": {
      "addProducts": [
        { "slug": "tta-bike-light", "name": "TTA Bike Light", "price": "$9.99" },
        { "slug": "tta-fleece-jacket", "name": "TTA Fleece Jacket", "price": "$49.99" },
        { "slug": "tta-practice-backpack", "name": "TTA Practice Backpack", "price": "$29.99" }
      ],
      "expectedBadge": "3"
    },
    "allProducts": {
      "addProducts": [
        { "slug": "test-allthethings-tshirt-red", "name": "Test.allTheThings() T-Shirt (Red)", "price": "$15.99" },
        { "slug": "tta-bike-light", "name": "TTA Bike Light", "price": "$9.99" },
        { "slug": "tta-bolt-tshirt", "name": "TTA Bolt T-Shirt", "price": "$15.99" },
        { "slug": "tta-fleece-jacket", "name": "TTA Fleece Jacket", "price": "$49.99" },
        { "slug": "tta-junior-tester-onesie", "name": "TTA Junior Tester Onesie", "price": "$7.99" },
        { "slug": "tta-practice-backpack", "name": "TTA Practice Backpack", "price": "$29.99" }
      ],
      "expectedBadge": "6"
    },
    "removeItemFromCart": {
      "addProducts": [
        { "slug": "tta-bike-light", "name": "TTA Bike Light", "price": "$9.99" },
        { "slug": "tta-fleece-jacket", "name": "TTA Fleece Jacket", "price": "$49.99" }
      ],
      "removeProducts": ["tta-bike-light"],
      "expectedBadge": "1"
    }
  }
}
